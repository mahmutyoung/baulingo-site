# Dedicated Baulingo read-only Cloudflare token. Never commit real credentials.
# Optional path to the existing baulingo-web Desktop OAuth client JSON, kept outside Git.
# The authorization script reads this from the process environment; it does not load .env.
# BAULINGO_GOOGLE_OAUTH_CLIENT_FILE=C:/path/to/existing-desktop-client.json
CLOUDFLARE_API_TOKEN=
# Optional; the check command discovers and validates these IDs.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_WEB_ANALYTICS_SITE_ID=
