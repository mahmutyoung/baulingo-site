    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "seo:performance": "node scripts/seo-performance.ts",
    "seo:indexing": "node scripts/seo-indexing.ts",
    "seo:map": "node scripts/seo-content.ts",
    "seo:combined": "node scripts/seo-ga4.ts",
