    "cloudflare:traffic": "node scripts/cloudflare-report.ts traffic",
    "cloudflare:performance": "node scripts/cloudflare-report.ts performance",
    "cloudflare:coverage": "node scripts/cloudflare-coverage.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.4",
